{
  "name": "playbook-vscode",
  "displayName": "Playbook UI Helper",
  "description": "Developer experience enhancements for Playbook UI design system - snippets, autocomplete, and hover documentation for Rails and React",
  "version": "2.2.1",
  "publisher": "ClancyTools",
  "icon": "enhanced_logo.png",
  "engines": {
    "vscode": "^1.75.0",
    "node": ">=22"
  },
  "categories": [
    "Snippets",
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "playbook",
    "design system",
    "rails",
    "react",
    "snippets",
    "autocomplete",
    "intellisense",
    "erb",
    "jsx",
    "tsx",
    "ui components",
    "powerhome"
  ],
  "activationEvents": [
    "onLanguage:ruby",
    "onLanguage:erb",
    "onLanguage:html.erb",
    "onLanguage:html",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onView:playbookKits",
    "onCommand:playbook.browseKits",
    "onCommand:playbook.findDeprecated",
    "onCommand:playbook.reloadMetadata",
    "onCommand:playbook.showInfo",
    "onCommand:playbook.findBootstrap",
    "onCommand:playbook.showGlobalProps"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "snippets": [
      {
        "language": "ruby",
        "path": "./snippets/rails.json"
      },
      {
        "language": "erb",
        "path": "./snippets/rails.json"
      },
      {
        "language": "html.erb",
        "path": "./snippets/rails.json"
      },
      {
        "language": "html",
        "path": "./snippets/rails.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/react.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/react.json"
      }
    ],
    "languages": [
      {
        "id": "erb"
      },
      {
        "id": "html.erb"
      }
    ],
    "configuration": {
      "title": "Playbook UI Helper",
      "properties": {
        "playbook.diagnostics.deprecations": {
          "type": "boolean",
          "default": true,
          "description": "Flag deprecated Playbook props (shown struck through)."
        },
        "playbook.diagnostics.propDependencies": {
          "type": "boolean",
          "default": true,
          "description": "Flag props that have no effect without another prop (for example formPillProps without multiSelect)."
        },
        "playbook.diagnostics.externalDependencies": {
          "type": "boolean",
          "default": true,
          "description": "Flag kits whose required host packages (Highcharts, maplibre-gl, ...) are not installed."
        },
        "playbook.spacingHints": {
          "type": "boolean",
          "default": true,
          "description": "Show the pixel value after spacing tokens, for example padding=\"md\" → 24px."
        },
        "playbook.axisHints": {
          "type": "boolean",
          "default": true,
          "description": "Show which way a flex value points after justify/align (and justifyContent/alignItems), for example \"↔ center\" in a row or \"↕ middle\" in a column."
        },
        "playbook.colorSwatches": {
          "type": "boolean",
          "default": true,
          "description": "Show a small square with the real color after Playbook color values: color tokens (backgroundColor=\"bg_light\"), Icon color and Legend color. Turn this off to hide them."
        },
        "playbook.icons.path": {
          "type": "string",
          "default": "",
          "description": "Folder containing the playbook-icons icons/ directory and aliases.json (for example a checkout of the playbook-icons repo, ~/Documents/Playbook/playbook-icons). Leave empty to use the package installed in the workspace. Used for icon name completions and the preview in hovers. The icons are private and are never bundled with this extension."
        },
        "playbook.diagnostics.unknownIcons": {
          "type": "boolean",
          "default": true,
          "description": "Flag icon names that look like a typo of a playbook-icons icon. Names with no close match are never flagged, since they may be Font Awesome icons."
        },
        "playbook.diagnostics.combineSpacing": {
          "type": "boolean",
          "default": true,
          "description": "Hint when two side props have the same value and can be one axis prop (paddingTop + paddingBottom → paddingY)."
        },
        "playbook.diagnostics.bootstrap": {
          "type": "boolean",
          "default": false,
          "description": "Hint on Bootstrap classes (btn btn-primary, panel, col-md-6, …) with the Playbook equivalent. Off by default: an app mid-migration has a lot of them. Use Playbook: Find Bootstrap Markup to scan a folder instead."
        },
        "playbook.diagnostics.requiredIndicator": {
          "type": "boolean",
          "default": true,
          "description": "Suggest required_indicator when a label on a Playbook input ends in a hand-written \"*\"."
        },
        "playbook.icons.previewColor": {
          "type": "string",
          "default": "",
          "description": "Color of the icon previews in hovers and completions, e.g. #4fc3f7 or white. Leave empty to match the theme (light gray on dark themes, dark gray on light ones)."
        },
        "playbook.diagnostics.unknownColors": {
          "type": "boolean",
          "default": true,
          "description": "Flag a color name that Icon or Legend doesn't define (for example Icon color=\"secondary\"), which means no color is applied."
        }
      }
    },
    "commands": [
      {
        "command": "playbook.browseKits",
        "title": "Browse Kits",
        "category": "Playbook",
        "icon": "$(symbol-class)"
      },
      {
        "command": "playbook.findDeprecated",
        "title": "Find Deprecated Usages",
        "category": "Playbook",
        "icon": "$(warning)"
      },
      {
        "command": "playbook.reloadMetadata",
        "title": "Reload Metadata",
        "category": "Playbook",
        "icon": "$(refresh)"
      },
      {
        "command": "playbook.showInfo",
        "title": "Show Playbook Info",
        "category": "Playbook"
      },
      {
        "command": "playbook.kitActions",
        "title": "Kit Actions",
        "category": "Playbook"
      },
      {
        "command": "playbook.findBootstrap",
        "title": "Find Bootstrap Markup",
        "category": "Playbook",
        "icon": "$(search)"
      },
      {
        "command": "playbook.showGlobalProps",
        "title": "Show Global Props",
        "category": "Playbook",
        "icon": "$(symbol-property)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "playbookKits",
          "name": "Playbook Kits",
          "icon": "$(symbol-class)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "playbook.browseKits",
          "when": "view == playbookKits",
          "group": "navigation@1"
        },
        {
          "command": "playbook.findDeprecated",
          "when": "view == playbookKits",
          "group": "navigation@2"
        },
        {
          "command": "playbook.reloadMetadata",
          "when": "view == playbookKits",
          "group": "navigation@3"
        },
        {
          "command": "playbook.findBootstrap",
          "when": "view == playbookKits",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "playbook.kitActions",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "playbook.findDeprecated",
          "when": "explorerResourceIsFolder || resourceExtname =~ /\\.(erb|rb|tsx|jsx|ts|js)$/",
          "group": "playbook@1"
        },
        {
          "command": "playbook.findBootstrap",
          "when": "explorerResourceIsFolder || resourceExtname =~ /\\.(erb|html|tsx|jsx)$/",
          "group": "playbook@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "lint": "eslint src --ext ts",
    "sync:data": "ts-node scripts/sync-playbook-data.ts"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.x",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^8.x",
    "glob": "^8.1.0",
    "mocha": "^10.8.2",
    "ts-node": "^10.x",
    "typescript": "^5.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ClancyTools/playbook_vscode_extension"
  },
  "bugs": {
    "url": "https://github.com/ClancyTools/playbook_vscode_extension/issues"
  },
  "homepage": "https://github.com/ClancyTools/playbook_vscode_extension#readme",
  "license": "MIT",
  "galleryBanner": {
    "color": "#1C1C1C",
    "theme": "dark"
  }
}
